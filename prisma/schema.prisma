generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- BẢN VẼ CẤU TRÚC DỮ LIỆU ---

// 1. Bảng không gian làm việc chung
model Pool {
  id        String    @id @default(cuid())
  name      String    @default("Ban Truyền thông Chánh Hưng")
  members   User[]
  tasks     Task[]
  messages  Message[] 
}

// 2. Bảng quản lý thành viên
model User {
  id        String    @id // Supabase Auth UID
  email     String    @unique
  name      String?
  avatarUrl String?
  unit      String?   // Đơn vị (VD: Bí thư chi Đoàn KP29)
  role      String    @default("MEMBER") // ADMIN, EDITOR, MEMBER
  status    String    @default("APPROVED") // PENDING, APPROVED, REJECTED
  tempPassword String? // Mật khẩu đăng ký ban đầu để Admin duyệt
  phone               String?
  address             String?      // Địa chỉ cá nhân
  isOnboarded         Boolean      @default(false) // Trạng thái đã hoàn thành onboarding
  position            String?      @default("Thành viên") // Chủ nhiệm, Phó Chủ nhiệm, Thành viên, CTV
  roles               String?      // Vai trò truyền thông (VD: Kỹ thuật truyền thông, Sự kiện, Nội dung)
  scoreQuickness      Int          @default(80)
  scoreFlexibility    Int          @default(80)
  scoreExpertise      Int          @default(80)
  scoreProblemSolving Int          @default(80)
  scoreCreativity     Int          @default(80)
  scoreResponsibility Int          @default(80)
  leaderEvaluation    String?      @db.Text
  poolId    String
  pool      Pool      @relation(fields: [poolId], references: [id])
  tasks     Task[]    @relation("TaskAssignee")
  assignedTasks Task[] @relation("TaskAssignees")
  messages  Message[] @relation("UserMessages")
  posts     Post[]    @relation("UserPosts")
  media     Media[]   @relation("UserMedia")
  meetingRequests MeetingRequest[] @relation("UserMeetingRequests")
  activities Activity[] @relation("UserActivities")
  votes     Vote[]     @relation("UserVotes")
  watching  TaskWatcher[] @relation("TaskWatchers")
  createdRooms ChatRoom[] @relation("RoomCreator")
  roomMemberships ChatRoomMember[] @relation("RoomMembers")
  createdEvents MeetingEvent[] @relation("EventCreator")
  eventAttendances MeetingAttendee[] @relation("EventAttendees")
  createdTasks Task[]    @relation("TaskCreator")
}

// 3. Bảng quản lý thẻ việc Kanban (Trello Card Style — v2)
model Task {
  id          String      @id @default(cuid())
  title       String
  description String?     @db.Text
  status      String      @default("TODO")
  order       Int         @default(0)
  priority    String      @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  attachments String[]    

  // Kanban v2 Extensions
  isPoolItem     Boolean   @default(false)   // Ghim vào Pool chung để nhắc nhở toàn đội
  reminderAt     DateTime?                   // Thời điểm nhắc nhở
  estimatedHours Int?                        // Ước tính số giờ thực hiện
  completedAt    DateTime?                   // Thời điểm hoàn thành thực tế
  tags           String[]                    // Tags nhanh (text)

  // Cột bổ sung cho bảng theo dõi (Excel)
  creatorId   String?
  creator     User?       @relation("TaskCreator", fields: [creatorId], references: [id])
  evaluation  String      @default("REVIEWING") // REVIEWING, APPROVED, REJECTED, POSTPONED
  evaluationNotes String? @db.Text
  productType String      @default("ALL")       // ALL, IMAGE, VIDEO, DOCUMENT


  poolId      String
  pool        Pool        @relation(fields: [poolId], references: [id])
  assigneeId  String?
  assignee    User?       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assignees   User[]      @relation("TaskAssignees")
  
  checklists  Checklist[]
  activities  Activity[]  @relation("TaskActivities")
  labels      TaskLabel[]
  watchers    TaskWatcher[]

  @@index([assigneeId, status, dueDate])
  @@index([poolId])
}

// Labels màu sắc cho Task
model TaskLabel {
  id      String @id @default(cuid())
  name    String
  color   String  // Hex color code (e.g. "#ef4444")
  taskId  String
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// Người theo dõi Task (Watchers)
model TaskWatcher {
  taskId  String
  userId  String
  task    Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User @relation("TaskWatchers", fields: [userId], references: [id])
  @@id([taskId, userId])
}

model Checklist {
  id          String          @id @default(cuid())
  title       String
  taskId      String
  task        Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items       ChecklistItem[]
}

model ChecklistItem {
  id          String    @id @default(cuid())
  text        String
  isCompleted Boolean   @default(false)
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  type      String   // 'MOVED', 'COMMENT', 'CREATED', 'COMPLETED', 'LABEL_ADDED'
  text      String
  createdAt DateTime @default(now())
  
  userId    String
  user      User     @relation("UserActivities", fields: [userId], references: [id])
  
  taskId    String
  task      Task     @relation("TaskActivities", fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, type, createdAt])
}

// 4a. Phòng chat nhóm (như Zalo group – tập hợp theo dự án/nhóm việc)
model ChatRoom {
  id          String    @id @default(cuid())
  name        String
  description String?
  icon        String    @default("💬") // emoji icon
  color       String    @default("#3b82f6") // accent color hex
  isDefault   Boolean   @default(false)   // Kênh chung mặc định
  createdAt   DateTime  @default(now())

  createdById String
  createdBy   User      @relation("RoomCreator", fields: [createdById], references: [id])

  members     ChatRoomMember[]
  messages    Message[]
}

model ChatRoomMember {
  roomId    String
  userId    String
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation("RoomMembers", fields: [userId], references: [id])
  joinedAt  DateTime @default(now())
  @@id([roomId, userId])

  @@index([userId])
}

// 4b. Bảng quản lý tin nhắn Chat nội bộ
model Message {
  id          String    @id @default(cuid())
  content     String?
  type        String    @default("TEXT") // TEXT, IMAGE, FILE, TASK_REF
  fileUrl     String?
  taskRef     String?   // Tham chiếu đến Task ID nếu type=TASK_REF
  
  poolId      String
  pool        Pool      @relation(fields: [poolId], references: [id])
  
  roomId      String?
  room        ChatRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  
  senderId    String
  sender      User      @relation("UserMessages", fields: [senderId], references: [id])
  
  createdAt   DateTime  @default(now())

  @@index([roomId, createdAt])
  @@index([senderId, createdAt])
}

// 5. Lịch họp vật lý (booking phòng họp) - giữ lại cũ
model Meeting {
  id           String   @id @default(cuid())
  topic        String
  startTime    DateTime
  endTime      DateTime?
  recordingUrl String? 
  summary      String?  // Biên bản / ghi chú cuộc họp

  @@index([startTime])
}

// 5b. Sự kiện lịch họp (Calendar events – có thể đăng ký tham dự)
model MeetingEvent {
  id           String    @id @default(cuid())
  title        String
  description  String?
  location     String?   // Địa điểm / link Meet / Zoom
  startTime    DateTime
  endTime      DateTime
  color        String    @default("#3b82f6")
  isRecurring  Boolean   @default(false)
  maxAttendees Int?

  createdById  String
  createdBy    User      @relation("EventCreator", fields: [createdById], references: [id])
  
  attendees    MeetingAttendee[]
  createdAt    DateTime  @default(now())
}

model MeetingAttendee {
  eventId  String
  userId   String
  event    MeetingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User         @relation("EventAttendees", fields: [userId], references: [id])
  @@id([eventId, userId])
}


// 6. Bảng Bài viết sẵn sàng xuất bản (Publishing Bridge)
model Post {
  id          String   @id @default(cuid())
  title       String
  content     String?  @db.Text
  status      String   @default("DRAFT") // DRAFT, PENDING, PUBLISHED
  mediaUrls   String[]
  feedback    String?  @db.Text
  
  authorId    String
  author      User     @relation("UserPosts", fields: [authorId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 7. Bảng quản lý kho tài nguyên Media Pool
model Media {
  id          String   @id @default(cuid())
  name        String
  url         String
  type        String   // IMAGE, VIDEO, DOCUMENT
  size        String?
  tag         String?
  
  uploaderId  String
  uploader    User     @relation("UserMedia", fields: [uploaderId], references: [id])
  
  createdAt   DateTime @default(now())
}

// 8. Thư viện thông tin
model LibraryItem {
  id        String   @id @default(cuid())
  title     String
  category  String
  content   String   @db.Text
  fileUrl   String?
  embedUrl  String?  // Đường dẫn nhúng (YouTube, TikTok...)
  password  String?  // Mật khẩu bảo vệ tải tài liệu
  createdAt DateTime @default(now())
}

// 9. Đăng ký phòng họp vật lý
model MeetingRequest {
  id          String   @id @default(cuid())
  roomName    String
  purpose     String
  startTime   DateTime
  endTime     DateTime
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedBy String
  user        User     @relation("UserMeetingRequests", fields: [requestedBy], references: [id])
  isAIApproved Boolean @default(false)
  createdAt   DateTime @default(now())
}

// 10. Cấu hình hệ thống động
model SystemConfig {
  key   String @id
  value String
}

// 11. Bảng Biểu quyết (VOTING)
model Poll {
  id          String   @id @default(cuid())
  question    String
  options     Json
  dueDate     DateTime?
  status      String   @default("OPEN") // OPEN, CLOSED
  createdAt   DateTime @default(now())
  votes       Vote[]
}

model Vote {
  id        String @id @default(cuid())
  pollId    String
  poll      Poll   @relation(fields: [pollId], references: [id])
  userId    String
  user      User   @relation("UserVotes", fields: [userId], references: [id])
  optionIdx Int
  
  @@unique([pollId, userId])
}

// 12. Bảng Biên Bản Họp (Meeting Minutes)
model MeetingMinutes {
  id              String   @id @default(cuid())
  meetingId       String   @unique // Cú pháp MEET_YYYYMMDD_NAME
  title           String
  timeLocation    String
  attendees       Json     // Lưu: { host: string, secretary: string, participants: string[] }
  goal            String   @db.Text
  summary         String   @db.Text // Tóm tắt cốt lõi 3-5 dòng
  actionItems     Json     // Lưu: Task[] -> { name, assignee, deadline, status, priority }
  issuesDecisions Json     // Lưu: { decisions: string[], issues: string[] }
  ideasInsights   Json     // Lưu: { ideas: string[] }
  createdAt       DateTime @default(now())
}

